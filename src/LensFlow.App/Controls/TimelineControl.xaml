<UserControl x:Class="LensFlow.App.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="154"
             Background="Transparent"
             UseLayoutRounding="True">
    <Border Background="#0D1016"
            BorderBrush="#242A36"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Canvas x:Name="TimelineCanvas"
                Background="Transparent"
                SizeChanged="TimelineCanvas_SizeChanged"
                MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown" />
    </Border>
</UserControl>
