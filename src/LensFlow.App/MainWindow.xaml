<Window x:Class="LensFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LensFlow.App.Controls"
        Title="LensFlow"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PageBrush}"
            BorderBrush="#272D38"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#101319"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3D72FF" />
                                    <GradientStop Color="#9C4DDE" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="L"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="13" />
                        </Border>
                        <TextBlock Text="LensFlow"
                                   Margin="9,0,0,0"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="HomeButton"
                            Grid.Column="1"
                            Content="文件"
                            Style="{StaticResource IconButtonStyle}"
                            FontFamily="Segoe UI Variable Text, Segoe UI"
                            FontSize="13"
                            Width="62"
                            Margin="18,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="HomeButton_Click" />

                    <TextBlock x:Name="HeaderProjectText"
                               Grid.Column="2"
                               Text="新建录制"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderStatusText"
                                   Text="准备就绪"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontSize="12" />
                        <ProgressBar x:Name="ExportProgressBar"
                                     Width="96"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed"
                                     Margin="0,0,10,0" />
                        <Button x:Name="ExportButton"
                                Content="导出"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="18,7"
                                Visibility="Collapsed"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Export_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="—"
                                Style="{StaticResource IconButtonStyle}"
                                FontFamily="Segoe UI Variable Text, Segoe UI"
                                FontSize="14"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow_Click" />
                        <Button Content="□"
                                Style="{StaticResource IconButtonStyle}"
                                FontFamily="Segoe UI Symbol"
                                FontSize="13"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeWindow_Click" />
                        <Button Content="×"
                                Style="{StaticResource IconButtonStyle}"
                                FontFamily="Segoe UI Variable Text, Segoe UI"
                                FontSize="17"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseWindow_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="StartView" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="520" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="1" Grid.Row="1">
                    <StackPanel Margin="0,0,0,28">
                        <TextBlock Text="让演示自动聚焦"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="录制屏幕与点击轨迹，自动生成平滑跟随镜头"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,9,0,0" />
                    </StackPanel>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="录制来源" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                            <ComboBox x:Name="SourceComboBox"
                                      DisplayMemberPath="Label"
                                      Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="录制帧率" VerticalAlignment="Center" />
                                <ComboBox x:Name="FrameRateComboBox" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="30 FPS" Tag="30" />
                                    <ComboBoxItem Content="60 FPS" Tag="60" />
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="SystemAudioCheckBox"
                                      Content="系统声音"
                                      IsChecked="True"
                                      Margin="0,0,0,16" />
                            <CheckBox x:Name="MicrophoneCheckBox"
                                      Content="麦克风"
                                      Margin="0,0,0,22" />

                            <Button x:Name="StartRecordingButton"
                                    Content="开始录制"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="StartRecording_Click" />

                            <Grid x:Name="RecordingControls" Visibility="Collapsed" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="RecordingTimeText"
                                               Text="00:00"
                                               FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="RecordingStatusText"
                                               Text="正在录制"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button x:Name="PauseRecordingButton"
                                        Grid.Column="1"
                                        Content="暂停"
                                        Margin="8,0"
                                        Click="PauseRecording_Click" />
                                <Button x:Name="StopRecordingButton"
                                        Grid.Column="2"
                                        Content="停止并编辑"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="StopRecording_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0">
                        <Button Content="打开已有项目"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="OpenProject_Click" />
                        <Button Content="刷新来源"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="{StaticResource MutedBrush}"
                                Click="RefreshSources_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="EditorView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#101319"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Margin="8,14">
                        <RadioButton x:Name="CanvasToolButton"
                                     GroupName="Tools"
                                     Content="画"
                                     ToolTip="视频美化"
                                     Style="{StaticResource ToolRailButtonStyle}"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     IsChecked="True"
                                     Checked="ToolTab_Checked" />
                        <RadioButton x:Name="CursorToolButton"
                                     GroupName="Tools"
                                     Content="标"
                                     ToolTip="光标"
                                     Style="{StaticResource ToolRailButtonStyle}"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Checked="ToolTab_Checked" />
                        <RadioButton x:Name="CameraToolButton"
                                     GroupName="Tools"
                                     Content="镜"
                                     ToolTip="缩放镜头"
                                     Style="{StaticResource ToolRailButtonStyle}"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Checked="ToolTab_Checked" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="20">
                        <StackPanel x:Name="CanvasSettingsPanel">
                            <TextBlock Text="视频美化" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,24" />
                            <TextBlock Text="视频尺寸" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <RadioButton Content="原始"
                                             Tag="Original"
                                             GroupName="AspectRatio"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             IsChecked="True"
                                             Checked="AspectRatio_Checked" />
                                <RadioButton Content="16:9"
                                             Tag="Landscape16By9"
                                             GroupName="AspectRatio"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             Checked="AspectRatio_Checked" />
                                <RadioButton Content="1:1"
                                             Tag="Square"
                                             GroupName="AspectRatio"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             Checked="AspectRatio_Checked" />
                                <RadioButton Content="4:3"
                                             Tag="Standard4By3"
                                             GroupName="AspectRatio"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             Checked="AspectRatio_Checked" />
                                <RadioButton Content="9:16"
                                             Tag="Portrait9By16"
                                             GroupName="AspectRatio"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             Checked="AspectRatio_Checked" />
                            </WrapPanel>
                            <Border Background="#151922" CornerRadius="9" Padding="13" Margin="0,20,0,0">
                                <TextBlock Text="MVP 暂不提供内边距、外边框、圆角和背景素材。"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="19" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="CursorSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="光标" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,24" />
                            <TextBlock Text="录制时已保存鼠标移动与点击轨迹，用于自动生成跟随镜头。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="20" />
                            <Border Background="#151922" CornerRadius="9" Padding="13" Margin="0,18,0,0">
                                <TextBlock Text="光标样式替换不在当前 MVP 范围内。"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="CameraSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="缩放设置" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,22" />
                            <TextBlock x:Name="CameraSelectionHint"
                                       Text="请在镜头轨选择一个缩放元素。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,18" />
                            <StackPanel x:Name="CameraPropertyFields" IsEnabled="False">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="缩放大小" />
                                    <TextBlock x:Name="ZoomValueText"
                                               Text="1.6x"
                                               Foreground="#8EAEFF"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="ZoomSlider"
                                        Minimum="1.2"
                                        Maximum="3"
                                        Value="1.6"
                                        SmallChange="0.1"
                                        PreviewMouseLeftButtonDown="ZoomSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="ZoomSlider_PreviewMouseLeftButtonUp"
                                        ValueChanged="ZoomSlider_ValueChanged" />
                                <Button Content="应用至全部缩放效果"
                                        Margin="0,18,0,0"
                                        HorizontalContentAlignment="Center"
                                        Click="ApplyZoomToAll_Click" />
                                <Button Content="删除当前缩放效果"
                                        Foreground="{StaticResource DangerBrush}"
                                        Background="Transparent"
                                        BorderBrush="#5A3038"
                                        Margin="0,10,0,0"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteSelected_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ClipSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="视频切片" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,22" />
                            <TextBlock x:Name="ClipRangeText"
                                       Text="--"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="将播放头移动到切片内部，然后点击时间轴工具栏的切片按钮，或按 Ctrl+B。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="230" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="PreviewHost"
                          Grid.Row="0"
                          Background="#080A0E"
                          SizeChanged="PreviewHost_SizeChanged">
                        <Border x:Name="PreviewFrame"
                                Background="#111318"
                                BorderBrush="#242B36"
                                BorderThickness="1"
                                CornerRadius="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="PreviewMedia"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Uniform"
                                              ScrubbingEnabled="True"
                                              MediaOpened="PreviewMedia_MediaOpened"
                                              MediaEnded="PreviewMedia_MediaEnded"
                                              RenderTransformOrigin="0.5,0.5">
                                    <MediaElement.RenderTransform>
                                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                                    </MediaElement.RenderTransform>
                                </MediaElement>
                                <StackPanel x:Name="EmptyEditorState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="正在准备预览…" FontSize="16" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#CC101319"
                                CornerRadius="9"
                                Padding="10,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayPauseButton"
                                        Content="▶"
                                        Style="{StaticResource IconButtonStyle}"
                                        FontFamily="Segoe UI Symbol"
                                        FontSize="14"
                                        IsEnabled="False"
                                        Click="PlayPause_Click" />
                                <TextBlock x:Name="TimelineTimeText"
                                           Text="00:00 / 00:00"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,4,0"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#101319"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10,14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="时间轴"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="4,0,16,0" />
                                    <Button x:Name="SplitButton"
                                            Content="✂"
                                            ToolTip="切片 (Ctrl+B)"
                                            Style="{StaticResource IconButtonStyle}"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="15"
                                            IsEnabled="False"
                                            Click="Split_Click" />
                                    <Button x:Name="UndoButton"
                                            Content="↶"
                                            ToolTip="撤销 (Ctrl+Z)"
                                            Style="{StaticResource IconButtonStyle}"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="18"
                                            IsEnabled="False"
                                            Click="Undo_Click" />
                                    <Button x:Name="RedoButton"
                                            Content="↷"
                                            ToolTip="恢复 (Ctrl+Y)"
                                            Style="{StaticResource IconButtonStyle}"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="18"
                                            IsEnabled="False"
                                            Click="Redo_Click" />
                                    <Button x:Name="DeleteButton"
                                            Content="⌫"
                                            ToolTip="删除选中元素 (Delete)"
                                            Style="{StaticResource IconButtonStyle}"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="16"
                                            IsEnabled="False"
                                            Click="DeleteSelected_Click" />
                                </StackPanel>
                                <TextBlock Text="选择元素后可切片 · Ctrl+B"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                            </Grid>
                            <controls:TimelineControl x:Name="Timeline"
                                                      Grid.Row="1"
                                                      PlayheadChanged="Timeline_PlayheadChanged"
                                                      SelectionChanged="Timeline_SelectionChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
