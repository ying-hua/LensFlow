<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LensFlow.Core\LensFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bundled FFmpeg build is dynamically linked: ffmpeg.exe needs its
         sibling avcodec-*.dll/avformat-*.dll/etc. to load, so the whole
         tools\ffmpeg\bin folder must ship together, not just the exe. -->
    <Content Include="..\..\tools\ffmpeg\bin\**\*"
             Link="tools\ffmpeg\bin\%(RecursiveDir)%(Filename)%(Extension)"
             Condition="Exists('..\..\tools\ffmpeg\bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
